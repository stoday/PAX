# PAX 環境變數設定範例
# 複製此檔案為 .env 並填入實際值

GOOGLE_MAP_API_KEY=
GEMINI_API_KEY=
MCP_SERVER_PORT=

# Pax Runtime 模式設定 (local 或 cloud)
PAX_MODE=local
PAX_SERVER_URL=http://localhost:8000
PAX_CLOUD_API_KEY=your_secret_uuid_here
# 若設備驗證 (ADPT) 失敗，請填入您 Chrome 的 User Data 路徑 (需關閉 Chrome 才能擷取)
# 範例: CHROME_PROFILE_PATH=C:\Users\YourName\AppData\Local\Google\Chrome\User Data
CHROME_PROFILE_PATH=
